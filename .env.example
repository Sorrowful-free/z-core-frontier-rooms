# Скопируйте в .env или экспортируйте в shell. Файл .env не коммитить.
# Минимум для запуска cmd/rooms:

ADMISSION_SECRET=replace-with-random-secret-at-least-32-bytes-long!!

# REST control plane (обязателен, если HTTP_AUTH_DISABLED не true)
HTTP_API_KEY=replace-with-random-api-key-16-chars-min

# Опционально:
# LOG_MODE=prod
# HTTP_ADDR=:3000
# ADMISSION_TTL=1h
# HTTP_AUTH_DISABLED=true
# MAX_ROOMS=500
# HTTP_CREATE_RATE_PER_MIN=30
# HTTP_ISSUE_RATE_PER_MIN=60
# HTTP_DELETE_RATE_PER_MIN=30
# HTTP_LIST_RATE_PER_MIN=60
# RECONNECT_TTL=30s
# RESERVATION_ORPHAN_SWEEP_INTERVAL=10s
# TRANSPORT_MAX_INCOMING_FRAME_BYTES=262144
# TRANSPORT_ROOM_INCOMING_QUEUE=128
# TRANSPORT_PEER_OUTBOUND_QUEUE=128
# TRANSPORT_ENET_INCOMING_QUEUE=256
# TRANSPORT_PEER_IDLE_TIMEOUT=30s
# TRANSPORT_PEER_IDLE_SWEEP_INTERVAL=10s
# TRANSPORT_WS_WRITE_DEADLINE=10s
# ENET_LISTEN_PORTS=7777
# ENET_LISTEN_PORT=7777
# ENET_PEER_LIMIT=64
# ENET_ADMIT_TIMEOUT=10s
# ADMIN_LISTEN_ADDR=:9091
