# Скопируйте в .env или экспортируйте в shell. Файл .env не коммитить.
# Минимум для запуска cmd/rooms:

ADMISSION_SECRET=replace-with-random-secret-at-least-32-bytes-long!!

# REST control plane (обязателен, если HTTP_AUTH_DISABLED не true)
HTTP_API_KEY=replace-with-random-api-key-16-chars-min

# Опционально:
# ADMISSION_TTL=1h
# ADMISSION_PASSWORD=
# HTTP_AUTH_DISABLED=true
