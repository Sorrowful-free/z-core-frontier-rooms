# .env.loadtest — env-пресет сервера cmd/rooms для нагрузочных прогонов (P27).
# Загружается оркестратором scripts/loadtest-run.sh (`set -a; . .env.loadtest`).
# Секретов нет: ADMISSION_SECRET генерируется оркестратором в рантайме.
# Лимиты по умолчанию душат прогон (MAX_ROOMS=500, rate-limits per-IP) —
# здесь они отключены.

HTTP_AUTH_DISABLED=true
MAX_ROOMS=0
HTTP_CREATE_RATE_PER_MIN=0
HTTP_ISSUE_RATE_PER_MIN=0
HTTP_DELETE_RATE_PER_MIN=0
HTTP_LIST_RATE_PER_MIN=0

ADMIN_LISTEN_ADDR=:9091

TRANSPORT_ROOM_INCOMING_QUEUE=512
TRANSPORT_PEER_OUTBOUND_QUEUE=512
TRANSPORT_ENET_INCOMING_QUEUE=1024

ENET_PEER_LIMIT=4095
ENET_LISTEN_PORTS=5000,5001,5002,5003
